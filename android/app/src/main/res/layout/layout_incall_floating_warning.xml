<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="#E6111827"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENTINELSHIELD LIVE CALL WARNING"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInCallRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RISK: 94% AI SYNTHETIC VOICE CLONE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Do NOT share banking OTPs, PINs or transfer money to any 'safe account'. This caller appears to be using an AI voice cloning system."
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🔒 Privacy Lock: Zero Call Recording (Acoustic Signal Physics Only)"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="italic" />

</LinearLayout>

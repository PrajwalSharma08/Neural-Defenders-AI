{
  "id": "/Neural-Defenders-AI/",
  "name": "SentinelShield AI — Cyber Threat Defense",
  "short_name": "SentinelShield",
  "description": "Sub-Second Multi-Modal Voice Deepfake, Phishing & Digital Arrest Defense Platform for Android & Web",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "prefer_related_applications": false,
  "orientation": "portrait-primary",
  "background_color": "#080914",
  "theme_color": "#4f46e5",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    {
      "src": "./img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./img/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SentinelShield Cyber Defense Dashboard"
    },
    {
      "src": "./img/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "In-Call Mobile Guard"
    }
  ],
  "shortcuts": [
    {
      "name": "Voice Forensics",
      "short_name": "Voice Shield",
      "description": "Scan call audio for synthetic voice clones",
      "url": "./voice-shield.html",
      "icons": [{ "src": "./img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Link Shield",
      "short_name": "Link Shield",
      "description": "Inspect phishing & typosquatting URLs",
      "url": "./link-shield.html",
      "icons": [{ "src": "./img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "SMS Extortion Shield",
      "short_name": "SMS Shield",
      "description": "Digital arrest scam detector",
      "url": "./sms-shield.html",
      "icons": [{ "src": "./img/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./link-shield.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./voice-shield.html",
      "name": "Audio Forensics Scanner",
      "icons": [{ "src": "./img/icon-192.png", "sizes": "192x192" }],
      "accept": {
        "audio/wav": [".wav"],
        "audio/mpeg": [".mp3"],
        "audio/ogg": [".ogg"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+sentinel",
      "url": "./link-shield.html?url=%s"
    }
  ],
  "widgets": [
    {
      "name": "SentinelShield Quick Guard",
      "short_name": "Quick Guard",
      "description": "Instant Cyber Defense Threat Scanner",
      "tag": "sentinel-guard",
      "template": "widget-template",
      "ms_ac_template": "widget-template.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "./img/screenshot-mobile.png",
          "sizes": "720x1280",
          "label": "Quick Threat Guard Widget"
        }
      ],
      "icons": [
        {
          "src": "./img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
